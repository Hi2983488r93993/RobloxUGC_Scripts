local function GetNearestItem()
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    if not hrp or not SpawnBahan then return nil, nil, nil end

    local function SearchProcess(ignoreBlacklist)
        local nearestPart = nil
        local nearestPrompt = nil
        local nearestSpawnName = nil
        local minDistance = math.huge

        for spawnName, isEnabled in pairs(ActiveToggles) do
            if isEnabled then
                local currentCount = ITEM_IDS[spawnName] and GetItemCountById(ITEM_IDS[spawnName]) or 0
                
                local isOverLimit = false
                if ITEM_IDS[spawnName] then
                    local limitVal = ItemLimits[spawnName] or 30
                    if currentCount >= limitVal then
                        isOverLimit = true
                    end
                end

                local isNextIfReached = false
                if ITEM_IDS[spawnName] then
                    local nextIfVal = ItemNextIf[spawnName] or 0
                    if nextIfVal > 0 then
                        if not SessionStartCounts[spawnName] then
                            SessionStartCounts[spawnName] = currentCount
                        end
                        local gained = currentCount - SessionStartCounts[spawnName]
                        if gained >= nextIfVal then
                            isNextIfReached = true
                        end
                    end
                end

                if not isOverLimit and not isNextIfReached then
                    for _, spawnFolder in pairs(SpawnBahan:GetChildren()) do
                        if spawnFolder.Name == spawnName then
                            for _, descendant in pairs(spawnFolder:GetDescendants()) do
                                if descendant:IsA("ProximityPrompt") and descendant.Name == "AmbilPrompt" and descendant.Enabled == true then
                                    if ignoreBlacklist or not BlacklistedPrompts[descendant] then
                                        local part = descendant.Parent
                                        if part and part:IsA("BasePart") then
                                            local dist = (hrp.Position - part.Position).Magnitude
                                            if dist < minDistance then
                                                minDistance = dist
                                                nearestPart = part
                                                nearestPrompt = descendant
                                                nearestSpawnName = spawnName
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return nearestPart, nearestPrompt, nearestSpawnName
    end

    local part, prompt, spawnName = SearchProcess(false)
    if part then return part, prompt, spawnName end

    local allActiveNextIfFinished = true
    local hasAnyNextIfActive = false

    for k, v in pairs(ItemNextIf) do
        if ActiveToggles[k] and v > 0 then
            hasAnyNextIfActive = true
            local currentCount = ITEM_IDS[k] and GetItemCountById(ITEM_IDS[k]) or 0
            local startCount = SessionStartCounts[k] or currentCount
            if (currentCount - startCount) < v then
                allActiveNextIfFinished = false
                break
            end
        end
    end

    if hasAnyNextIfActive and allActiveNextIfFinished then
        SessionStartCounts = {}
        part, prompt, spawnName = SearchProcess(false)
        if part then return part, prompt, spawnName end
    end

    part, prompt, spawnName = SearchProcess(true)
    if part then
        BlacklistedPrompts = {}
        return part, prompt, spawnName
    end

    return nil, nil, nil
end

