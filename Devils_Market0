task.spawn(function()
    local targetPivotPos = Vector3.new(1909, 113.505959, 145.797318)
    local maxDistance = 3 -- Lệch tối đa 3 studs

    local function CheckAndDelete(instance)
        if instance:IsA("Model") and instance.Name == "Sketchfab_Scene" then
            local current = instance.Parent
            local isUnderDekorasi = false
            while current do
                if current.Name == "Dekorasi" then
                    isUnderDekorasi = true
                    break
                end
                current = current.Parent
            end

            if isUnderDekorasi then
                task.spawn(function()
                    for i = 1, 50 do
                        if not instance or not instance.Parent then break end
                        
                        local currentPivot = instance:GetPivot().Position
                        local dist = (currentPivot - targetPivotPos).Magnitude
                        
                        if dist <= maxDistance then
                            instance:Destroy()
                            break
                        end
                        task.wait(0.1)
                    end
                end)
            end
        end
    end

    for _, item in pairs(Workspace:GetDescendants()) do
        CheckAndDelete(item)
    end

    Workspace.DescendantAdded:Connect(CheckAndDelete)
end)

local function HoldPrompt(prompt)
    if prompt and prompt:IsA("ProximityPrompt") then
        if prompt.HoldDuration > 0 then
            prompt:InputHoldBegin()
            task.wait(0.01)
            prompt:InputHoldEnd()
            fireproximityprompt(prompt)
        end
    end
end

local function WalkToPosition(targetInput, checkCondition)
    local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
    local humanoid = character:WaitForChild("Humanoid", 3)
    local hrp = character:WaitForChild("HumanoidRootPart", 3)
    if not humanoid or not hrp or humanoid.Health <= 0 then return false end

    local function GetCurrentTargetPos()
        if type(targetInput) == "function" then
            return targetInput()
        end
        return targetInput
    end

    local currentTargetPos = GetCurrentTargetPos()
    if not currentTargetPos then return false end

    humanoid:MoveTo(currentTargetPos)
    
    local reached = false
    local connection
    connection = humanoid.MoveToFinished:Connect(function(status)
        reached = true
        if connection then connection:Disconnect() end
    end)
    
    local lastMoveTick = tick()
    local lastCheckTick = tick()
    local stuckYTick = nil
    local lastPosition = hrp.Position

    local stuckCheckTick = tick()
    local stuckStartPos = hrp.Position

    while not reached do
        local currentCharacter = LocalPlayer.Character
        if not currentCharacter or not currentCharacter.Parent then
            if connection then connection:Disconnect() end
            return false
        end
        
        local currentHumanoid = currentCharacter:FindFirstChildOfClass("Humanoid")
        local currentHrp = currentCharacter:FindFirstChild("HumanoidRootPart")
        
        if not currentHumanoid or not currentHrp or currentHumanoid.Health <= 0 then
            if connection then connection:Disconnect() end
            return false
        end

        if checkCondition and not checkCondition() then
            currentHumanoid:MoveTo(currentHrp.Position)
            if connection then connection:Disconnect() end
            return false
        end

        local updatedTargetPos = GetCurrentTargetPos()
        if not updatedTargetPos then
            currentHumanoid:MoveTo(currentHrp.Position)
            if connection then connection:Disconnect() end
            return false
        end

        local currentPos = currentHrp.Position
        local distToTarget = (currentPos - updatedTargetPos).Magnitude
        local movedDist = (currentPos - lastPosition).Magnitude

        local distXZ = Vector2.new(currentPos.X - updatedTargetPos.X, currentPos.Z - updatedTargetPos.Z).Magnitude
        local distY = math.abs(currentPos.Y - updatedTargetPos.Y)

        if distXZ <= 5 and distY > 5 then
            if not stuckYTick then
                stuckYTick = tick()
            elseif tick() - stuckYTick >= 7 then
                if connection then connection:Disconnect() end
                currentHumanoid.Health = 0
                return false
            end
        else
            stuckYTick = nil
        end

        if tick() - stuckCheckTick >= 3 then
            local distIn3s = (currentPos - stuckStartPos).Magnitude
            if distIn3s < 4 and distToTarget > 5 then
                for i = 1, 3 do
                    if currentHumanoid and currentHumanoid.Health > 0 then
                        currentHumanoid:ChangeState(Enum.HumanoidStateType.Jumping)
                        currentHumanoid:MoveTo(updatedTargetPos)
                        task.wait(0.15)
                    end
                end
            end
            stuckCheckTick = tick()
            stuckStartPos = currentPos
        end

        if distXZ <= 5 and distY <= 5 then
            lastCheckTick = tick()
            lastPosition = currentPos
            if connection then connection:Disconnect() end
            break
        elseif movedDist > 5 then
            lastPosition = currentPos
            lastCheckTick = tick()
        else
            if distXZ > 5 and tick() - lastCheckTick >= 7 then
                if connection then connection:Disconnect() end
                currentHumanoid.Health = 0
                return false
            end
        end
        
        if tick() - lastMoveTick >= 0.2 then
            currentHumanoid:MoveTo(updatedTargetPos)
            lastMoveTick = tick()
        end
        
        task.wait(0.1)
    end
    
    return true
end

