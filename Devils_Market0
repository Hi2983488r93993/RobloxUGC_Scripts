local function CreateToggle(parent, text, callback, toggleKey, hasTextBox, defaultLimit, defaultNextIf)
    local key = toggleKey or text
    local Frame = Instance.new("Frame")
    Frame.Name = "Toggle_" .. key
    Frame.Size = UDim2.new(1, -5, 0, 30)
    Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Frame.Active = true
    Frame.Parent = parent

    -- Dời xích qua trái một chút và áp dụng TextScaled theo yêu cầu
    local labelWidth = hasTextBox and -235 or -40
    local Label = Instance.new("TextLabel")
    Label.Name = "ToggleLabel"
    Label.Size = UDim2.new(1, labelWidth, 1, 0)
    Label.Position = UDim2.new(0, 8, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "<b>" .. text .. "</b>"
    Label.RichText = true
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.SourceSansBold
    Label.TextScaled = true
    Label.Active = true
    Label.Parent = Frame

    local TextBoxObj = nil
    local NextIfTextBoxObj = nil

    if hasTextBox then
        local limitVal = defaultLimit or 30
        local nextIfVal = defaultNextIf or 0
        ItemLimits[key] = limitVal
        ItemNextIf[key] = nextIfVal

        local TextBox = Instance.new("TextBox")
        TextBox.Name = "LimitTextBox"
        TextBox.Size = UDim2.new(0, 60, 0, 22)
        TextBox.Position = UDim2.new(1, -210, 0, 4)
        TextBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        TextBox.Text = "Dừng khi:" .. tostring(limitVal)
        TextBox.TextColor3 = Color3.fromRGB(200, 200, 200)
        TextBox.Font = Enum.Font.SourceSansBold
        TextBox.TextSize = 11
        TextBox.ClearTextOnFocus = true
        TextBox.Parent = Frame

        TextBox.FocusLost:Connect(function(enterPressed)
            local num = tonumber(TextBox.Text:match("%d+"))
            if num then
                ItemLimits[key] = num
                TextBox.Text = "Dừng khi:" .. tostring(num)
            else
                TextBox.Text = "Dừng khi:" .. tostring(ItemLimits[key] or 30)
            end
            if SaveConfig then SaveConfig() end
        end)
        TextBoxObj = TextBox

        local NextIfTextBox = Instance.new("TextBox")
        NextIfTextBox.Name = "NextIfTextBox"
        NextIfTextBox.Size = UDim2.new(0, 65, 0, 22)
        NextIfTextBox.Position = UDim2.new(1, -145, 0, 4)
        NextIfTextBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        NextIfTextBox.Text = "Đổi khi:" .. tostring(nextIfVal)
        NextIfTextBox.TextColor3 = Color3.fromRGB(200, 200, 200)
        NextIfTextBox.Font = Enum.Font.SourceSansBold
        NextIfTextBox.TextSize = 11
        NextIfTextBox.ClearTextOnFocus = true
        NextIfTextBox.Parent = Frame

        NextIfTextBox.FocusLost:Connect(function(enterPressed)
            local num = tonumber(NextIfTextBox.Text:match("%d+"))
            if num then
                ItemNextIf[key] = num
                NextIfTextBox.Text = "Đổi khi:" .. tostring(num)
            else
                NextIfTextBox.Text = "Đổi khi:" .. tostring(ItemNextIf[key] or 0)
            end
            if SaveConfig then SaveConfig() end
        end)
        NextIfTextBoxObj = NextIfTextBox
    end

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 28, 0, 24)
    Button.Position = UDim2.new(1, -32, 0, 3)
    Button.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
    Button.Text = "<b>Tắt</b>"
    Button.RichText = true
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Font = Enum.Font.SourceSansBold
    Button.TextSize = 10
    Button.Active = true
    Button.Parent = Frame

    local toggled = false

    local function SetState(state, suppressSave)
        toggled = state
        Button.Text = toggled and "<b>Bật</b>" or "<b>Tắt</b>"
        Button.BackgroundColor3 = toggled and Color3.fromRGB(30, 100, 30) or Color3.fromRGB(100, 30, 30)
        
        if toggled then
            SessionStartCounts[key] = nil
        end

        callback(toggled)
        if not suppressSave and SaveConfig then
            SaveConfig()
        end
    end

    Button.MouseButton1Click:Connect(function()
        SetState(not toggled)
    end)
    
    ToggleObjects[key] = {
        SetState = SetState,
        GetState = function() return toggled end,
        TextBox = TextBoxObj,
        NextIfTextBox = NextIfTextBoxObj,
        Label = Label
    }

    return Frame
end

