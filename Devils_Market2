    Label.Position = UDim2.new(0, 8, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = "<b>" .. text .. "</b>"
    Label.RichText = true
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.SourceSansBold
    Label.TextScaled = true
    Label.Active = true
    Label.Parent = Frame

    local TextBoxObj = nil
    local NextIfTextBoxObj = nil
    local ReqTextBoxObj = nil

    if hasTextBox then
        if isKiosMode then
            local reqVal = defaultLimit or 5
            ItemRequirements[key] = reqVal

            local ReqTextBox = Instance.new("TextBox")
            ReqTextBox.Name = "ReqTextBox"
            ReqTextBox.Size = UDim2.new(0, 65, 0, 22)
            ReqTextBox.Position = UDim2.new(1, -125, 0, 4)
