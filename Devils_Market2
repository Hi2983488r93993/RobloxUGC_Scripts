local function UpdateUIScale()
    local camera = Workspace.CurrentCamera
    if camera then
        local viewportSize = camera.ViewportSize
        local isMobile = UserInputService.TouchEnabled and not UserInputService.KeyboardEnabled
        local baseScale = math.min(viewportSize.X / 900, viewportSize.Y / 500)
        
        if isMobile then
            UIScale.Scale = math.clamp(baseScale * 1.35, 1.1, 1.8)
        else
            UIScale.Scale = math.clamp(baseScale, 0.8, 1.3)
        end
    end
end
