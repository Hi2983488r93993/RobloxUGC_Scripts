local function GetScreenCenterPos(instance)
    if not instance then return nil end
    return Vector2.new(instance.AbsolutePosition.X + (instance.AbsoluteSize.X / 2), instance.AbsolutePosition.Y + (instance.AbsoluteSize.Y / 2))
end

local function ExecuteSingleClick(btn, method)
    if not btn or not btn.Visible then return end
    local centerPos = GetScreenCenterPos(btn)
    local startX, startY = centerPos and centerPos.X or 0, centerPos and centerPos.Y or 0

    pcall(function()
        if method == "VirtualInput" and centerPos then
            VirtualInputManager:SendMouseButtonEvent(startX, startY, 0, true, game, 0)
            task.wait(0.01)
            VirtualInputManager:SendMouseButtonEvent(startX, startY, 0, false, game, 0)

        elseif method == "VirtualTouch" and centerPos then
            local touchId = 9999
            VirtualInputManager:SendTouchEvent(touchId, 0, startX, startY)
            task.wait(0.01)
            VirtualInputManager:SendTouchEvent(touchId, 2, startX, startY)

        elseif method == "Keyboard" then
            VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Return, false, game)
            task.wait(0.05)
            VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Return, false, game)

        elseif method == "TweenHack" then
            local origSize = btn.Size
            local tween = TweenService:Create(btn, TweenInfo.new(0.05, Enum.EasingStyle.Linear), {Size = origSize + UDim2.new(0, 2, 0, 2)})
            tween:Play()
            task.wait(0.05)
            btn.Size = origSize
            if firesignal then firesignal(btn.MouseButton1Click) end

        elseif method == "GetConnections" and getconnections then
            for _, c in ipairs(getconnections(btn.MouseButton1Click)) do if c.Function then c:Fire() end end
            for _, c in ipairs(getconnections(btn.Activated)) do if c.Function then c:Fire() end end

        elseif method == "FireSignal" and firesignal then
            firesignal(btn.MouseButton1Click)
            firesignal(btn.Activated)
        end
    end)
end

local function ClickButton(btn)
    if not btn then return end
    if SelectedClickMethod == "AllCombo" then
        for _, m in ipairs({"VirtualInput", "VirtualTouch", "Keyboard", "TweenHack", "GetConnections", "FireSignal"}) do
            ExecuteSingleClick(btn, m)
        end
    else
        ExecuteSingleClick(btn, SelectedClickMethod)
    end
end

