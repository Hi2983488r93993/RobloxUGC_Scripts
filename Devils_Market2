local function ExtractQuota(text)
    if not text or type(text) ~= "string" then return "0/5" end
    for match in string.gmatch(text, "(%d+/%d+)") do
        local n1, n2 = string.match(match, "(%d+)/(%d+)")
        if n1 and n2 then
            local num1, num2 = tonumber(n1), tonumber(n2)
            if num1 and num2 and num1 <= 20 and num2 <= 20 then
                return match
            end
        end
    end
    return "0/5"
end

local function ExtractPrice(priceObj)
    if not priceObj then return 0 end
    if priceObj:IsA("TextLabel") or priceObj:IsA("TextBox") then
        local txt = priceObj.Text or ""
        local cleanedTxt = string.gsub(txt, "[,%s%.]", "")
        local num = tonumber(string.match(cleanedTxt, "%d+"))
        return num or 0
    end
    return 0
end

