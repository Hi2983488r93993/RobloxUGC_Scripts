local function WaitAndFireDialogOption1()
    pcall(function()
        local dialogGui = LocalPlayer:FindFirstChild("PlayerGui") and LocalPlayer.PlayerGui:FindFirstChild("dialog")
        if dialogGui then
            local responses = dialogGui:FindFirstChild("dialogResponses")
            if responses then
                local btn1 = responses:FindFirstChild("1")
                if btn1 then
                    local startTime = tick()
                    while tick() - startTime < 5 do
                        if btn1.Visible == true then
                            -- Chờ 0.1s để UI hoàn tất Animation / Signal binding của game
                            task.wait(0.1)

                            -- 1. Thử dùng hàm ClickButton tổng hợp sẵn trong script (nếu có)
                            if ClickButton then
                                ClickButton(btn1)
                            end

                            -- 2. Kích hoạt toàn bộ signal phòng trường hợp game dùng listener khác
                            if firesignal then
                                --pcall(function() firesignal(btn1.MouseButton1Click) end)
                                pcall(function() firesignal(btn1.Activated) end)
                                pcall(function() firesignal(btn1.MouseButton1Down) end)
                                pcall(function() firesignal(btn1.MouseButton1Up) end)
                            end

                            -- 3. Giả lập VirtualInput bằng tọa độ tuyệt đối nếu các hàm trên thất bại
                            if VirtualInputManager and btn1.AbsolutePosition then
                                local center = Vector2.new(
                                    btn1.AbsolutePosition.X + (btn1.AbsoluteSize.X / 2),
                                    btn1.AbsolutePosition.Y + (btn1.AbsoluteSize.Y / 2)
                                )
                                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, true, game, 0)
                                task.wait(0.02)
                                VirtualInputManager:SendMouseButtonEvent(center.X, center.Y, 0, false, game, 0)
                            end

                            break
                        end
                        task.wait(0.1)
                    end
                end
            end
        end
    end)
end


