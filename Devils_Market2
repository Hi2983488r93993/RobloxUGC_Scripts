local function GetItemCountById(targetIdStr)
    if not targetIdStr then return 0 end
    local count = 0
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return end

        local backpack = playerGui:FindFirstChild("BackpackGui") and playerGui.BackpackGui:FindFirstChild("Backpack")
        if not backpack then return end

        local searchContainers = {}
        
        local inventoryGrid = backpack:FindFirstChild("Inventory") 
            and backpack.Inventory:FindFirstChild("ScrollingFrame") 
            and backpack.Inventory.ScrollingFrame:FindFirstChild("UIGridFrame")
        if inventoryGrid then table.insert(searchContainers, inventoryGrid) end

        local hotbar = backpack:FindFirstChild("Hotbar")
        if hotbar then table.insert(searchContainers, hotbar) end

        for _, container in ipairs(searchContainers) do
            for _, slot in pairs(container:GetChildren()) do
                local icon = slot:FindFirstChild("Icon")
                if icon and icon:IsA("ImageLabel") and type(icon.Image) == "string" and icon.Image:find(targetIdStr) then
                    local toolName = slot:FindFirstChild("ToolName")
                    if toolName and toolName:IsA("TextLabel") and type(toolName.Text) == "string" then
                        local countMatch = toolName.Text:match("[xX](%d+)")
                        if countMatch then
                            count = tonumber(countMatch) or 0
                            return
                        else
                            count = 1
                            return
                        end
                    end
                end
            end
        end
    end)

    return count
end

local function GetInventoryItemCountByName(itemName)
    if not itemName then return 0 end
    local total = 0
    pcall(function()
        local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
        if not playerGui then return end

        local backpack = playerGui:FindFirstChild("BackpackGui") and playerGui.BackpackGui:FindFirstChild("Backpack")
