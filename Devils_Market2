local function CheckCardIngredients(card)
    if not card then return false end
    local row = card:FindFirstChild("Row")
    if not row then return false end

    local ingInfo = row:FindFirstChild("IngInfo")
    if not ingInfo or not ingInfo:IsA("TextLabel") then return false end

    local text = ingInfo.Text
    local current, required = text:match("(%d+)/(%d+)")
    if current and required then
        local curNum = tonumber(current)
        local reqNum = tonumber(required)
        if curNum and reqNum then
            return curNum >= reqNum
        end
    end

    return false
end

