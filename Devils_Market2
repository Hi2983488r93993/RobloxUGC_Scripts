            ReqTextBox.TextColor3 = Color3.fromRGB(200, 200, 200)
            ReqTextBox.Font = Enum.Font.SourceSansBold
            ReqTextBox.TextSize = 11
            ReqTextBox.ClearTextOnFocus = true
            ReqTextBox.Parent = Frame

            ReqTextBox.FocusLost:Connect(function(enterPressed)
                local num = tonumber(ReqTextBox.Text:match("%d+"))
                if num then
                    ItemRequirements[key] = num
                    ReqTextBox.Text = "Yêu cầu:" .. tostring(num)
                else
                    ReqTextBox.Text = "Yêu cầu:" .. tostring(ItemRequirements[key] or 5)
