-- 2. Tạo giao diện UI với cơ chế On Top chuẩn mẫu
local g_ui = Instance.new("ScreenGui") 
g_ui.Name = "ULTIMATE_BLOCKER" 
g_ui.ResetOnSpawn = false
g_ui.DisplayOrder = 2147483647 
g_ui.IgnoreGuiInset = true

-- Hàm chạy liên tục trên RenderStepped để đưa UI lên trên cùng (On Top tuyệt đối)
local function f_top() 
    for _, c in ipairs(CoreGui:GetChildren()) do 
        if c:IsA("ScreenGui") and c ~= g_ui then 
            if c.DisplayOrder >= g_ui.DisplayOrder then 
                c.DisplayOrder = 2147483646 
            end 
        end 
    end 
    g_ui.DisplayOrder = 2147483647 
    local p_node = CoreGui:FindFirstChild("PurchasePrompt") or CoreGui:FindFirstChild("RobloxGui") or CoreGui 
    if g_ui.Parent ~= p_node then 
        g_ui.Parent = p_node 
    end 
end
RunService.RenderStepped:Connect(f_top)

