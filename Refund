-- 3. Hàm cập nhật thông báo UI
local function updateDebug(msg, col) 
    debugLabel.Text = msg 
    if col then 
        debugLabel.TextColor3 = col 
    end 
    if string.len(msg) > 40 then 
        debugLabel.Font = Enum.Font.SourceSans 
    else 
        debugLabel.Font = Enum.Font.SourceSansBold 
    end 
end 

-- 4. Hàm gửi tín hiệu hủy mua hàng
local function sendSingleFail(id) 
    pcall(function() 
        task.wait() 
        MS:SignalPromptPurchaseFinished(lp, id, false) 
    end) 
end 

-- 5. Bắt sự kiện yêu cầu mua hàng và xử lý
MS.PromptPurchaseRequestedV2:Connect(function(player, assetId) 
    if player == lp then 
        sendSingleFail(assetId) 
        local isOwned = false
        pcall(function()
            isOwned = MS:PlayerOwnsAsset(lp, assetId)
        end)
        local status = isOwned and "Đã Sở Hữu" or "Chưa Sở Hữu"
        updateDebug("💓 Đã Refund, ID: " .. tostring(assetId) .. " (" .. status .. ") 💓", Color3.fromRGB(255, 255, 0)) 
    end 
end)
