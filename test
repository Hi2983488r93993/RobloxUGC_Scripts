task.spawn(function()
	local Players = game:GetService("Players")
	local Workspace = game:GetService("Workspace")
	local RunService = game:GetService("RunService")

	local LocalPlayer = Players.LocalPlayer
	local Camera = Workspace.CurrentCamera

	-- UI Container
	local ScreenGui = Instance.new("ScreenGui")
	ScreenGui.Name = "TaroTrackerUI"
	ScreenGui.ResetOnSpawn = false
	ScreenGui.Parent = LocalPlayer:WaitForChild("PlayerGui")

	-- Main Frame (Center Screen & Responsive)
	local MainFrame = Instance.new("Frame")
	MainFrame.Name = "MainFrame"
	MainFrame.AnchorPoint = Vector2.new(0.5, 0.5)
	MainFrame.Position = UDim2.new(0.5, 0, 0.5, 0)
	MainFrame.Size = UDim2.new(0.7, 0, 0.95, 0) -- Mở rộng chiều cao và chiều rộng thêm 0.3
	MainFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 35)
	MainFrame.BorderSizePixel = 0
	MainFrame.Active = true
	MainFrame.Draggable = true
	MainFrame.Parent = ScreenGui

	-- UI Aspect Constraint (Đảm bảo khung không quá hẹp trên Mobile)
	local UIConstraint = Instance.new("UISizeConstraint")
	UIConstraint.MinSize = Vector2.new(380, 420)
	UIConstraint.MaxSize = Vector2.new(750, 850)
	UIConstraint.Parent = MainFrame

	local MainCorner = Instance.new("UICorner")
	MainCorner.CornerRadius = UDim.new(0, 8)
	MainCorner.Parent = MainFrame

	-- TextLabel hiển thị Taro của LocalPlayer (Nằm trên cùng UI, phía trên Title, ngoài ScrollFrame)
	local LocalPlayerLabel = Instance.new("TextLabel")
	LocalPlayerLabel.Name = "LocalPlayerLabel"
	LocalPlayerLabel.Size = UDim2.new(1, 0, 0.08, 0)
	LocalPlayerLabel.Position = UDim2.new(0, 0, -0.09, 0)
	LocalPlayerLabel.BackgroundColor3 = Color3.fromRGB(0, 150, 90)
	LocalPlayerLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
	LocalPlayerLabel.TextScaled = true
	LocalPlayerLabel.Font = Enum.Font.SourceSansBold
	LocalPlayerLabel.Text = "Đang tải dữ liệu..."
	LocalPlayerLabel.Parent = MainFrame

	local LocalPlayerCorner = Instance.new("UICorner")
	LocalPlayerCorner.CornerRadius = UDim.new(0, 8)
	LocalPlayerCorner.Parent = LocalPlayerLabel

	-- Title
	local Title = Instance.new("TextLabel")
	Title.Name = "Title"
	Title.Size = UDim2.new(1, 0, 0.08, 0)
	Title.BackgroundColor3 = Color3.fromRGB(45, 45, 50)
	Title.Text = "TARO MONITOR"
	Title.TextColor3 = Color3.fromRGB(255, 255, 255)
	Title.TextScaled = true
	Title.Font = Enum.Font.SourceSansBold
	Title.Parent = MainFrame

	local TitleCorner = Instance.new("UICorner")
	TitleCorner.CornerRadius = UDim.new(0, 8)
	TitleCorner.Parent = Title

	-- ScrollingFrame (Player List)
	local ScrollFrame = Instance.new("ScrollingFrame")
	ScrollFrame.Name = "PlayerList"
	ScrollFrame.Position = UDim2.new(0.05, 0, 0.1, 0)
	ScrollFrame.Size = UDim2.new(0.9, 0, 0.42, 0)
	ScrollFrame.BackgroundTransparency = 1
	ScrollFrame.BorderSizePixel = 0
	ScrollFrame.ScrollBarThickness = 6
	ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	ScrollFrame.Parent = MainFrame

	local UIListLayout = Instance.new("UIListLayout")
	UIListLayout.Parent = ScrollFrame
	UIListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	UIListLayout.Padding = UDim.new(0, 6)

	UIListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		ScrollFrame.CanvasSize = UDim2.new(0, 0, 0, UIListLayout.AbsoluteContentSize.Y + 10)
	end)

	-- Frame khoảng cách phân chia giữa LocalPlayer và người chơi khác
	local Spacer = Instance.new("Frame")
	Spacer.Name = "Spacer"
	Spacer.Size = UDim2.new(1, 0, 0, 10)
	Spacer.BackgroundTransparency = 1
	Spacer.LayoutOrder = 0
	Spacer.Parent = ScrollFrame

	-- ScrollingFrame (So sánh)
	local CompareScrollFrame = Instance.new("ScrollingFrame")
	CompareScrollFrame.Name = "CompareScrollFrame"
	CompareScrollFrame.Position = UDim2.new(0.05, 0, 0.54, 0)
	CompareScrollFrame.Size = UDim2.new(0.9, 0, 0.43, 0)
	CompareScrollFrame.BackgroundTransparency = 1
	CompareScrollFrame.BorderSizePixel = 0
	CompareScrollFrame.ScrollBarThickness = 6
	CompareScrollFrame.CanvasSize = UDim2.new(0, 0, 0, 0)
	CompareScrollFrame.Parent = MainFrame

	local CompareListLayout = Instance.new("UIListLayout")
	CompareListLayout.Parent = CompareScrollFrame
	CompareListLayout.SortOrder = Enum.SortOrder.LayoutOrder
	CompareListLayout.Padding = UDim.new(0, 6)

	CompareListLayout:GetPropertyChangedSignal("AbsoluteContentSize"):Connect(function()
		CompareScrollFrame.CanvasSize = UDim2.new(0, 0, 0, CompareListLayout.AbsoluteContentSize.Y + 10)
	end)

	-- Quản lý View Camera
	local viewingPlayer = nil
	local cameraConnection = nil

	local function viewPlayer(targetPlayer)
		if cameraConnection then
			cameraConnection:Disconnect()
			cameraConnection = nil
		end

		if targetPlayer and targetPlayer.Character and targetPlayer.Character:FindFirstChild("Humanoid") then
			viewingPlayer = targetPlayer
			Camera.CameraType = Enum.CameraType.Custom
			Camera.CameraSubject = targetPlayer.Character.Humanoid
		else
			viewingPlayer = nil
			if LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("Humanoid") then
				Camera.CameraSubject = LocalPlayer.Character.Humanoid
			end
		end
	end

	-- Các biến theo dõi Taro & Tốc độ
	local toggles = {}
	local compareLabels = {}
	local lastTaroValue = nil
	local lastCheckTime = os.clock()
	local currentTaroRate = 0
	local lastValidRate = 0

	while true do
		---------------------------------------------------------
		-- 1. XỬ LÝ DANH SÁCH PLAYERS & TOGGLES (SCROLLFRAME 1)
		---------------------------------------------------------
		local currentPlayers = Players:GetPlayers()
		local activePlayers = {}
		local playerTaroList = {}

		for _, player in ipairs(currentPlayers) do
			activePlayers[player] = true
			
			local numValue = 0
			local leaderstats = player:FindFirstChild("leaderstats")
			if leaderstats then
				local taro = leaderstats:FindFirstChild("Taro")
				if taro and typeof(taro.Value) == "number" then
					numValue = taro.Value
				end
			end

			if player == LocalPlayer then
				-- Cập nhật TextLabel của LocalPlayer trên đỉnh UI
				LocalPlayerLabel.Text = string.format("%s (%s): %s", player.Name, player.DisplayName, tostring(numValue))

				-- Theo dõi tốc độ tăng Taro của LocalPlayer
				local currentTime = os.clock()
				if lastTaroValue ~= nil then
					local deltaTime = currentTime - lastCheckTime
					local deltaTaro = numValue - lastTaroValue
					if deltaTime > 0 and deltaTaro >= 0 then
						currentTaroRate = deltaTaro / deltaTime
						if currentTaroRate > 0 then
							lastValidRate = currentTaroRate
						end
					end
				end
				lastTaroValue = numValue
				lastCheckTime = currentTime
			else
				table.insert(playerTaroList, {player = player, taro = numValue})

				local displayText = string.format("%s (%s): %s", player.Name, player.DisplayName, tostring(numValue))

				-- Tạo Toggle cho người chơi khác nếu chưa có
				if not toggles[player] then
					local button = Instance.new("TextButton")
					button.Name = player.Name
					button.Size = UDim2.new(1, 0, 0, 45)
					button.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
					button.TextColor3 = Color3.fromRGB(255, 255, 255)
					button.TextScaled = true
					button.Font = Enum.Font.SourceSansBold
					button.TextXAlignment = Enum.TextXAlignment.Left
					button.AutoButtonColor = true
					button.Parent = ScrollFrame

					local btnCorner = Instance.new("UICorner")
					btnCorner.CornerRadius = UDim.new(0, 5)
					btnCorner.Parent = button

					local btnPadding = Instance.new("UIPadding")
					btnPadding.PaddingLeft = UDim.new(0, 10)
					btnPadding.Parent = button

					local isViewing = false

					button.MouseButton1Click:Connect(function()
						isViewing = not isViewing
						
						if isViewing then
							for p, item in pairs(toggles) do
								if p ~= player then
									item.isViewing = false
									item.button.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
								end
							end
							button.BackgroundColor3 = Color3.fromRGB(0, 170, 100)
							viewPlayer(player)
						else
							button.BackgroundColor3 = Color3.fromRGB(50, 50, 60)
							viewPlayer(nil)
						end
						
						toggles[player].isViewing = isViewing
					end)

					toggles[player] = {
						button = button,
						isViewing = false
					}
				end

				toggles[player].button.Text = displayText
			end
		end

		-- Sắp xếp người chơi khác theo Taro giảm dần
		table.sort(playerTaroList, function(a, b)
			return a.taro > b.taro
		end)

		for rank, data in ipairs(playerTaroList) do
			if toggles[data.player] then
				toggles[data.player].button.LayoutOrder = rank -- Xếp giảm dần bên dưới Spacer
			end
		end

		-- Xóa UI người chơi thoát
		for player, data in pairs(toggles) do
			if not activePlayers[player] then
				if viewingPlayer == player then
					viewPlayer(nil)
				end
				data.button:Destroy()
				toggles[player] = nil
			end
		end

		---------------------------------------------------------
		-- 2. XỬ LÝ SCROLLFRAME "SO SÁNH" (SCROLLFRAME 2)
		---------------------------------------------------------
		local targetValuesSet = {}
		local targetValuesList = {}

		-- Quét tìm TextLabel trong UGC CanvasGroup (Sử dụng GetDescendants để quét triệt để)
		local playerGui = LocalPlayer:FindFirstChild("PlayerGui")
		if playerGui then
			local freeUGC = playerGui:FindFirstChild("FreeUGCRewardsGui")
			if freeUGC then
				local canvasGroup = freeUGC:FindFirstChild("CanvasGroup")
				if canvasGroup then
					local ugcScroll = canvasGroup:FindFirstChild("ScrollingFrame")
					if ugcScroll then
						for _, descendant in ipairs(ugcScroll:GetDescendants()) do
							if descendant:IsA("TextLabel") and descendant.Name == "TextLabel" then
								-- Bóc tách chuỗi số và loại bỏ các ký tự không phải chữ số
								local rawText = descendant.Text
								local numberMatch = string.match(rawText, "%d[%d,.]*")
								if numberMatch then
									local cleanNumberStr = string.gsub(numberMatch, "[^%d]", "")
									local num = tonumber(cleanNumberStr)
									if num and num >= 100000 and not targetValuesSet[num] then
										targetValuesSet[num] = true
										table.insert(targetValuesList, num)
									end
								end
							end
						end
					end
				end
			end
		end

		-- Sắp xếp danh sách mốc mục tiêu tăng dần
		table.sort(targetValuesList, function(a, b) return a < b end)

		local activeTargets = {}

		for _, targetNum in ipairs(targetValuesList) do
			activeTargets[targetNum] = true

			if not compareLabels[targetNum] then
				local compLabel = Instance.new("TextLabel")
				compLabel.Name = "Target_" .. tostring(targetNum)
				compLabel.Size = UDim2.new(1, 0, 0, 65)
				compLabel.BackgroundColor3 = Color3.fromRGB(40, 40, 50)
				compLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
				compLabel.TextScaled = true
				compLabel.Font = Enum.Font.SourceSansBold
				compLabel.TextXAlignment = Enum.TextXAlignment.Left
				compLabel.TextWrapped = true
				compLabel.Parent = CompareScrollFrame

				local compCorner = Instance.new("UICorner")
				compCorner.CornerRadius = UDim.new(0, 5)
				compCorner.Parent = compLabel

				local compPadding = Instance.new("UIPadding")
				compPadding.PaddingLeft = UDim.new(0, 8)
				compPadding.PaddingRight = UDim.new(0, 8)
				compPadding.Parent = compLabel

				compareLabels[targetNum] = compLabel
			end

			-- Lắng nghe khi Taro thực sự tăng (lastValidRate > 0) mới cập nhật nội dung TextLabel
			if lastValidRate > 0 then
				local currentTaro = lastTaroValue or 0
				local formattedTarget = string.format("%q", targetNum):gsub('"', '')

				local taroNeeded = math.max(0, targetNum - currentTaro)
				local secondsLeft = math.ceil(taroNeeded / lastValidRate)

				local hours = math.floor(secondsLeft / 3600)
				local minutes = math.floor((secondsLeft % 3600) / 60)
				local secs = secondsLeft % 60

				-- Tính thời gian đích đến GMT+7
				local targetUnix = os.time() + 25200 + secondsLeft
				local dateTable = os.date("!*t", targetUnix)
				local timeStr = string.format("%02d:%02d:%02d, Ngày %02d tháng %02d", dateTable.hour, dateTable.min, dateTable.sec, dateTable.day, dateTable.month)

				compareLabels[targetNum].Text = string.format(
					"Đang có %s. Đạt %s cần %dh %d phút %d giây nữa (tốc độ tăng %.1f/s)\nƯớc tính đạt ở mốc: %s",
					tostring(currentTaro), formattedTarget, hours, minutes, secs, lastValidRate, timeStr
				)
				compareLabels[targetNum].TextColor3 = Color3.fromRGB(255, 255, 255)
			end
		end

		-- Mất Frame hoặc thay đổi UGC sẽ tự xóa UI cũ
		for targetNum, label in pairs(compareLabels) do
			if not activeTargets[targetNum] then
				label:Destroy()
				compareLabels[targetNum] = nil
			end
		end

		task.wait(0.5)
	end
end)
