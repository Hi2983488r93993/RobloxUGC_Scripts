-- ==========================================
-- XỬ LÝ QUÉT VÀ DESTROY BAHANVISUAL TẠI WORLDPIVOT CỤ THỂ
-- ==========================================
task.spawn(function()
    local targetCFrame = CFrame.new(
        1894.71826, 121.404633, 128.12262,
        1, 0, 0,
        0, 1, 0,
        0, 0, 1
    )

    local function IsMatchingCFrame(cf1, cf2)
        local p1, p2 = cf1.Position, cf2.Position
        if (p1 - p2).Magnitude > 0.05 then return false end
        
        local x1, y1, z1, R001, R011, R021, R101, R111, R121, R201, R211, R221 = cf1:GetComponents()
        local x2, y2, z2, R002, R012, R022, R102, R112, R122, R202, R212, R222 = cf2:GetComponents()
        
        return math.abs(R001 - R002) < 0.01 and math.abs(R111 - R112) < 0.01 and math.abs(R221 - R222) < 0.01
    end

    local function CheckAndDestroyBahanVisual(instance)
        if instance and instance.Name == "BahanVisual" and instance:IsA("Model") then
            -- Kiểm tra nếu nằm trong Workspace.SpawnBahan.Spawn_Dupa
            if instance:IsDescendantOf(Workspace:FindFirstChild("SpawnBahan")) then
                local pivot = instance:GetPivot()
                if IsMatchingCFrame(pivot, targetCFrame) then
                    instance:Destroy()
                end
            end
        end
    end

    -- Quét liên tục mỗi 0.2s để phát hiện và destroy model
    while task.wait(0.2) do
        local spawnDupa = Workspace:FindFirstChild("SpawnBahan") 
            and Workspace.SpawnBahan:FindFirstChild("Spawn_Dupa")
        
        if spawnDupa then
            for _, item in pairs(spawnDupa:GetDescendants()) do
                CheckAndDestroyBahanVisual(item)
            end
        end
    end
end)

