                if spawnName == "Spawn_KepitingSungai" and dist2D <= 5 then
                    if SelectedMoveMethod == "JoystickHold" then
                        -- Mô phỏng đẩy Joystick/Nút bấm di chuyển xuống theo hướng mắt nhìn thực tế
                        local moveDir = (part.Position - hrp.Position).Unit
                        humanoid:Move(moveDir, true)
                    elseif SelectedMoveMethod == "TweenDrag" then
                        -- Dùng Tween Drag kéo mượt vị trí nhân vật xuống đáy
                        local tweenInfo = TweenInfo.new(0.3, Enum.EasingStyle.Linear)
                        local tween = TweenService:Create(hrp, tweenInfo, {CFrame = CFrame.new(part.Position)})
                        tween:Play()
                    elseif SelectedMoveMethod == "PhysicsSwim" then
                        -- Sử dụng gia tốc LinearVelocity kéo vật lý xuống tự nhiên không trôi
                        local att = hrp:FindFirstChild("SwimAttachment") or Instance.new("Attachment", hrp)
                        att.Name = "SwimAttachment"
                        local lv = hrp:FindFirstChild("SwimLV") or Instance.new("LinearVelocity", hrp)
                        lv.Name = "SwimLV"
                        lv.Attachment0 = att
                        lv.MaxForce = 99999
                        lv.VectorVelocity = (part.Position - hrp.Position).Unit * 20
                        task.delay(0.5, function() lv:Destroy() end)
                    elseif SelectedMoveMethod == "CFrameStep" then
                        -- Dịch chuyển trực tiếp theo từng bước CFrame ngắn
                        hrp.CFrame = CFrame.new(part.Position)
                    else
                        -- Mặc định dùng Humanoid:MoveTo
                        humanoid:MoveTo(part.Position)
                    end
                end

                if (hrp.Position - part.Position).Magnitude > 6 then
                    -- Truyền hàm động GetNearestItem() để nhân vật luôn di chuyển tới đối tượng GẦN NHẤT REALTIME
                    local walkSuccess = WalkToPosition(function()
                        local curPart, _, curSpawnName = GetNearestItem()
                        if curPart and curSpawnName == spawnName then
                            return curPart.Position
                        end
                        return part.Position
                    end, function()
                        if autoClaimPlotEnabled and not HasMyPlot(myAvatarId) then return false end
                        if autoCookEnabled and GetQSlotCount() < 3 and GetItemCountById(ITEM_IDS["Spawn_Dupa"]) >= 1 and GetItemCountById(ITEM_IDS["Spawn_KepitingSungai"]) >= 3 then return false end
                        if autoSeedShopEnabled or autoPigShopEnabled then return false end
                        return prompt and prompt.Parent and prompt.Enabled == true and ActiveToggles[spawnName] == true
                    end)
                    if not walkSuccess then break end
                end
                
                -- KIỂM TRA ĐIỀU KIỆN KẸT GẦN <= 5STUDS KHÔNG TÍNH Y TRONG 4 GIÂY
                local currentDist2D = Vector2.new(hrp.Position.X - part.Position.X, hrp.Position.Z - part.Position.Z).Magnitude
                if currentDist2D <= 5 then
                    if not nearStartTime then
                        nearStartTime = tick()
                    elseif tick() - nearStartTime >= 4 then
                        -- Đã tới gần <= 5studs không tính Y trong 4s mà chưa fireproximityprompt thành công -> Đưa vào Blacklist
                        BlacklistedPrompts[prompt] = true
                        break
                    end
                else
                    nearStartTime = nil
                end

                if hrp and (hrp.Position - part.Position).Magnitude <= 8 then
                    HoldPrompt(prompt)
                else
                    break
                end
                
                -- Đánh giá lại khoảng cách vật phẩm khác liên tục
                local newPart, _, _ = GetNearestItem()
                if newPart and newPart ~= part and (hrp.Position - newPart.Position).Magnitude < (hrp.Position - part.Position).Magnitude - 5 then
                    break -- Chuyển sang nhặt vật mới nếu xuất hiện món gần hơn đáng kể
                end
                
                task.wait(0.1)
            end
        end
    end
end)

-- Hàm tìm Plot trống gần nhất liên tục
local function GetNearestPlot(myAvatarId)
    local character = LocalPlayer.Character
    local hrp = character and character:FindFirstChild("HumanoidRootPart")
    local LahanPlot = Workspace:FindFirstChild("LahanPlot")
    if not hrp or not LahanPlot then return nil, nil, nil end

    local nearestPlot = nil
    local nearestTargetPart = nil
    local nearestPrompt = nil
    local minDistance = math.huge

    for _, plot in pairs(LahanPlot:GetChildren()) do
        local avatarImg = plot:FindFirstChild("Label") 
            and plot.Label:FindFirstChild("KebunLabel") 
            and plot.Label.KebunLabel:FindFirstChild("Root") 
            and plot.Label.KebunLabel.Root:FindFirstChild("AvatarBox") 
            and plot.Label.KebunLabel.Root.AvatarBox:FindFirstChild("Avatar")
            
        if avatarImg and avatarImg:IsA("ImageLabel") and avatarImg.Image == "" then
            local kiosPlot = Workspace:FindFirstChild("KiosPlot") and Workspace.KiosPlot:FindFirstChild("Plot" .. plot.Name)
            if kiosPlot then
                local targetPart = kiosPlot:IsA("BasePart") and kiosPlot or kiosPlot:FindFirstChildWhichIsA("BasePart") or kiosPlot
                local plotPrompt = kiosPlot:FindFirstChild("PlotPrompt") or (plot:FindFirstChild("Label") and plot.Label:FindFirstChild("LahanPrompt"))
                
                if targetPart then
                    local dist = (hrp.Position - targetPart.Position).Magnitude
                    if dist < minDistance then
                        minDistance = dist
                        nearestPlot = plot
                        nearestTargetPart = targetPart
                        nearestPrompt = plotPrompt
                    end
                end
            end
        end
    end

    return nearestPlot, nearestTargetPart, nearestPrompt
end

