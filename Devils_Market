-- LOGIC SAVE / LOAD CONFIGURATION JSON
SaveConfig = function()
    local data = {
        IsMinimized = isMinimized,
        SelectedMoveMethod = SelectedMoveMethod,
        SelectedClickMethod = SelectedClickMethod,
        Toggles = {},
        Limits = ItemLimits
    }

    for key, obj in pairs(ToggleObjects) do
        data.Toggles[key] = obj.GetState()
    end

    local success, encoded = pcall(function()
        return HttpService:JSONEncode(data)
    end)

    if success and writefile then
        pcall(function()
            writefile(ConfigFileName, encoded)
        end)
    end
end

LoadConfig = function()
    if not isfile or not isfile(ConfigFileName) or not readfile then return end

    local success, content = pcall(function()
        return readfile(ConfigFileName)
    end)

    if not success or not content then return end

    local decodeSuccess, data = pcall(function()
        return HttpService:JSONDecode(content)
    end)

    if not decodeSuccess or type(data) ~= "table" then return end

    -- Khôi phục trạng thái Minimize
    if data.IsMinimized ~= nil and data.IsMinimized ~= isMinimized then
        isMinimized = data.IsMinimized
        ContentContainer.Visible = not isMinimized
        if isMinimized then
            MainFrame.Size = UDim2.new(0, 450, 0, 35)
            MinimizeBtn.Text = "+"
        else
            MainFrame.Size = UDim2.new(0, 450, 0, 320)
            MinimizeBtn.Text = "-"
        end
    end

    -- Khôi phục Phương thức Di chuyển
    if data.SelectedMoveMethod and moveButtons[data.SelectedMoveMethod] then
        SelectedMoveMethod = data.SelectedMoveMethod
        for k, button in pairs(moveButtons) do
            if k == SelectedMoveMethod then
                button.BackgroundColor3 = Color3.fromRGB(0, 150, 80)
                button.Text = "USE"
            else
                button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                button.Text = "SET"
            end
        end
    end

    -- Khôi phục Phương thức Click
    if data.SelectedClickMethod and clickButtons[data.SelectedClickMethod] then
        SelectedClickMethod = data.SelectedClickMethod
        for id, button in pairs(clickButtons) do
            if id == SelectedClickMethod then
                button.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
                button.Text = "USE"
            else
                button.BackgroundColor3 = Color3.fromRGB(60, 60, 70)
                button.Text = "SET"
            end
        end
    end

    -- Khôi phục Limits
    if data.Limits and type(data.Limits) == "table" then
        for k, v in pairs(data.Limits) do
            ItemLimits[k] = v
            if ToggleObjects[k] and ToggleObjects[k].TextBox then
                ToggleObjects[k].TextBox.Text = "limit:" .. tostring(v)
            end
        end
    end

    -- Khôi phục tất cả Toggles ở các Tab
    if data.Toggles and type(data.Toggles) == "table" then
        for key, val in pairs(data.Toggles) do
            if ToggleObjects[key] then
                ToggleObjects[key].SetState(val, true)
            end
        end
    end
end

