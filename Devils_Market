local function CreateToggle(parent, text, callback, toggleKey, hasTextBox, defaultLimit)
    local key = toggleKey or text
    local Frame = Instance.new("Frame")
    Frame.Name = "Toggle_" .. key
    Frame.Size = UDim2.new(1, -5, 0, 30)
    Frame.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Frame.Active = true
    Frame.Parent = parent

    local labelWidth = hasTextBox and -115 or -40
    local Label = Instance.new("TextLabel")
    Label.Name = "ToggleLabel"
    Label.Size = UDim2.new(1, labelWidth, 1, 0)
    Label.Position = UDim2.new(0, 8, 0, 0)
    Label.BackgroundTransparency = 1
    Label.Text = text
    Label.TextColor3 = Color3.fromRGB(255, 255, 255)
    Label.TextXAlignment = Enum.TextXAlignment.Left
    Label.Font = Enum.Font.SourceSans
    Label.TextSize = 13
    Label.Active = true
    Label.Parent = Frame

    local TextBoxObj = nil
    if hasTextBox then
        local limitVal = defaultLimit or 30
        ItemLimits[key] = limitVal

        local TextBox = Instance.new("TextBox")
        TextBox.Name = "LimitTextBox"
        TextBox.Size = UDim2.new(0, 70, 0, 22)
        TextBox.Position = UDim2.new(1, -102, 0, 4)
        TextBox.BackgroundColor3 = Color3.fromRGB(20, 20, 25)
        TextBox.Text = "limit:" .. tostring(limitVal)
        TextBox.TextColor3 = Color3.fromRGB(200, 200, 200)
        TextBox.Font = Enum.Font.SourceSans
        TextBox.TextSize = 12
        TextBox.ClearTextOnFocus = true
        TextBox.Parent = Frame

        TextBox.FocusLost:Connect(function(enterPressed)
            local num = tonumber(TextBox.Text:match("%d+"))
            if num then
                ItemLimits[key] = num
                TextBox.Text = "limit:" .. tostring(num)
            else
                TextBox.Text = "limit:" .. tostring(ItemLimits[key] or 30)
            end
            if SaveConfig then SaveConfig() end
        end)
        TextBoxObj = TextBox
    end

    local Button = Instance.new("TextButton")
    Button.Size = UDim2.new(0, 24, 0, 24)
    Button.Position = UDim2.new(1, -28, 0, 3)
    Button.BackgroundColor3 = Color3.fromRGB(100, 30, 30)
    Button.Text = "OFF"
    Button.TextColor3 = Color3.fromRGB(255, 255, 255)
    Button.Font = Enum.Font.SourceSansBold
    Button.TextSize = 10
    Button.Active = true
    Button.Parent = Frame

    local toggled = false

    local function SetState(state, suppressSave)
        toggled = state
        Button.Text = toggled and "ON" or "OFF"
        Button.BackgroundColor3 = toggled and Color3.fromRGB(30, 100, 30) or Color3.fromRGB(100, 30, 30)
        callback(toggled)
        if not suppressSave and SaveConfig then
            SaveConfig()
        end
    end

    Button.MouseButton1Click:Connect(function()
        SetState(not toggled)
    end)
    
    ToggleObjects[key] = {
        SetState = SetState,
        GetState = function() return toggled end,
        TextBox = TextBoxObj,
        Label = Label
    }

    return Frame
end

