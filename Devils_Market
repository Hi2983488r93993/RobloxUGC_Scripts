                if ITEM_IDS[spawnName] then
                    local currentCount = GetItemCountById(ITEM_IDS[spawnName])
                    local limitVal = ItemLimits[spawnName] or 30
                    if currentCount >= limitVal then
                        isOverLimit = true
                    end
                end

                if not isOverLimit then
                    for _, spawnFolder in pairs(SpawnBahan:GetChildren()) do
                        if spawnFolder.Name == spawnName then
                            for _, descendant in pairs(spawnFolder:GetDescendants()) do
                                if descendant:IsA("ProximityPrompt") and descendant.Name == "AmbilPrompt" and descendant.Enabled == true then
                                    if ignoreBlacklist or not BlacklistedPrompts[descendant] then
                                        local part = descendant.Parent
                                        if part and part:IsA("BasePart") then
                                            local dist = (hrp.Position - part.Position).Magnitude
                                            if dist < minDistance then
                                                minDistance = dist
                                                nearestPart = part
                                                nearestPrompt = descendant
                                                nearestSpawnName = spawnName
                                            end
                                        end
                                    end
                                end
                            end
                        end
                    end
                end
            end
        end
        return nearestPart, nearestPrompt, nearestSpawnName
    end

    -- Quét đối tượng bình thường (không bị blacklist)
    local part, prompt, spawnName = SearchProcess(false)
    if part then return part, prompt, spawnName end

    -- Nếu không còn đối tượng nào khả thi, reset blacklist để đi tới đối tượng ưu tiên cuối cùng
    part, prompt, spawnName = SearchProcess(true)
    if part then
        BlacklistedPrompts = {} -- Xóa sạch danh sách đen để quét lại bình thường
        return part, prompt, spawnName
    end

    return nil, nil, nil
end

